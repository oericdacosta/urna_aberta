# Copie para .env e preencha. O .env nunca é versionado.
# Hoje só scripts/viabilidade.py e o workflow de viabilidade usam estas variáveis.

# URL do workspace Databricks, sem barra final (ex.: https://dbc-xxxx.cloud.databricks.com)
DATABRICKS_HOST=

# Personal access token do workspace (validade sugerida: 90 dias)
DATABRICKS_TOKEN=
